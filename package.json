{
  "name": "website-react",
  "private": true,
  "type": "module",
  "scripts": {
    "build:prod": "react-router build",
    "build:staging": "react-router build --mode staging",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "ultracite format"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.842.0",
    "@aws-sdk/lib-storage": "^3.842.0",
    "@babel/preset-typescript": "^7.27.1",
    "@prisma/client": "^6.13.0",
    "@react-router/node": "^7.7.1",
    "@react-router/remix-routes-option-adapter": "^7.7.1",
    "@react-router/serve": "^7.7.1",
    "@remix-run/form-data-parser": "^0.10.1",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "better-auth": "^1.3.7",
    "isbot": "^5.1.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.7.1",
    "remix-flat-routes": "^0.8.5",
    "remix-utils": "^8.8.0",
    "tailwind-merge": "^3.3.1",
    "vite-plugin-babel": "^1.3.2",
    "zod": "4.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@react-router/dev": "^7.7.1",
    "@storybook/addon-onboarding": "^9.1.0",
    "@storybook/react-vite": "^9.1.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "daisyui": "^5.0.50",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "msw": "^2.10.5",
    "msw-storybook-addon": "^2.0.5",
    "prisma": "^6.13.0",
    "storybook": "^9.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "ultracite": "5.1.2",
    "vite": "^7.0.6",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "pnpm": {
    "neverBuiltDependencies": []
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm biome check --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
