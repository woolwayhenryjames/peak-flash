{
  "$schema": "https://biomejs.dev/schemas/2.1.3/schema.json",
  "extends": ["ultracite"],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "includes": ["app/**"],
    "rules": {
      // tailwind uses @apply which is not a valid at-rule
      "nursery": {
        "noUnknownAtRule": "off",
        "useSortedClasses": "warn"
      },
      // vite strips the console.log statements anyway
      "suspicious": {
        "noConsole": "off",
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn"
      },
      "style": {
        "noEnum": "off",
        "useFilenamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "filenameCases": ["camelCase", "export"]
          }
        }
      },
      "a11y": {
        "useMediaCaption": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn"
      },
      "performance": {
        "noImgElement": "off"
      }
    }
  }
}
