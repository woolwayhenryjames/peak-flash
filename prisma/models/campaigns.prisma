model Campaign {
  id              String         @id @default(uuid())
  name            String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  description     String?        @db.Text
  endDate         DateTime
  image           String?        @db.Text
  joinRequirement String?        @db.LongText
  poolSize        Int            @default(0)
  startDate       DateTime
  order           Int            @default(0)
  poolUnit        String?        @db.VarChar(10)
  shareUrls       String         @default("[]") @db.LongText
  homepageUrl     String?        @db.Text
  poolDescription String?        @db.VarChar(50)
  ownerId         String?
  User            User?          @relation(fields: [ownerId], references: [id])
  campaignUsers   CampaignUser[]

  @@index([id])
  @@index([ownerId])
}

model CampaignUser {
  id         Int         @id @default(autoincrement())
  userId     String
  campaignId String
  score      Float       @default(0)
  joinedAt   DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
  baseScore  Float       @default(0)
  bonusScore Float       @default(0)
  videoCount Int         @default(0)
  rank       Int?
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  UserVideo  UserVideo[]

  @@unique([userId, campaignId])
  @@index([userId])
  @@index([campaignId])
  @@index([campaignId, score])
  @@index([campaignId, baseScore])
}
