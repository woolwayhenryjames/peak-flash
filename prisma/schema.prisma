// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  campaignUsers CampaignUser[]

  name          String    @db.Text
  email         String
  emailVerified Boolean
  image         String?   @db.Text
  kindleScore   Int       @default(0)
  sessions      Session[]
  accounts      Account[]

  // Invitation relationships
  inviterId String?
  inviter   User?   @relation("UserInvitations", fields: [inviterId], references: [id], onDelete: SetNull)
  invitees  User[]  @relation("UserInvitations")

  @@unique([email])
  @@index([id])
  @@index([kindleScore])
  @@index([inviterId])
}

model Campaign {
  id              String   @id @default(uuid())
  name            String
  image           String?  @db.Text
  poolSize        Int      @default(0)
  poolUnit        String?  @db.VarChar(10)
  startDate       DateTime
  endDate         DateTime
  description     String?  @db.Text
  joinRequirement Json?    @db.Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  order           Int      @default(0)

  campaignUsers CampaignUser[]

  @@index([id])
}

model CampaignUser {
  id         Int      @id @default(autoincrement())
  userId     String
  campaignId String
  baseScore  Int      @default(0) // User's own earned score
  bonusScore Int      @default(0) // 10% bonus from invited users
  score      Int      @default(0) // Computed column
  joinedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  videoCount Int      @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@index([userId])
  @@index([campaignId])
  @@index([campaignId, score])
  @@index([campaignId, baseScore])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String    @db.Text
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}
